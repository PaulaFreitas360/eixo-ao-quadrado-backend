# ═══════════════════════════════════════════════════════════════════════════
# EIXO AO QUADRADO — Configuração do Backend
# Copie este arquivo para .env e preencha com seus dados
# ═══════════════════════════════════════════════════════════════════════════

# SERVIDOR EXPRESS
PORT=3000
NODE_ENV=development

# CLAUDE API (para gerar matérias em HTML)
CLAUDE_API_KEY=sk-ant-v7-sua-chave-aqui

# EVOLUTION API / WHATSAPP
# Evolution é o gerenciador de múltiplas instâncias WhatsApp
EVOLUTION_API_URL=https://seu-evolution-instance.railway.app
EVOLUTION_API_KEY=sua-chave-evolution-aqui
EVOLUTION_INSTANCE_NAME=eixo-ao-quadrado

# PAULA (número que aprova matérias)
PAULA_WHATSAPP_NUMBER=61999116717

# GITHUB (para git push automático)
GITHUB_TOKEN=ghp_sua-chave-github-aqui
GITHUB_REPO=seu-usuario/eixo-ao-quadrado-site
GITHUB_BRANCH=main
GITHUB_COMMITTER_NAME=Eixo Automação
GITHUB_COMMITTER_EMAIL=bot@eixoaoquadrado.com.br

# HOSTINGER (FTP para upload de assets)
# Opcional se usar GitHub Actions como trigger
HOSTINGER_FTP_HOST=seu-dominio.com
HOSTINGER_FTP_USER=seu-usuario-ftp
HOSTINGER_FTP_PASS=sua-senha-ftp

# CAMINHOS
PROMPT_PATH=./prompts/prompt-geracao-materias.txt
SESSIONS_DB=./database/sessions.json
UPLOADS_DIR=./temp/uploads

# LOGGING
LOG_LEVEL=info
